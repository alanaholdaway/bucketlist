<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/logout" method="POST">
        <button type="submit">Logout</button>
    </form>
    <label><b>Country Information:</b></label>
    <br><br>
    <table style="width: 100%; background-color: antiquewhite; border: 1px solid black;">
        <thead style="background-color: cornflowerblue; color: white;">
            <tr>
                <th style="text-align: left;">Name</th>
                <th style="text-align: left;">Popular Site</th>
                <th style="text-align: left;">Capital</th>
                <th style="text-align: left;">Population</th>
                <th style="text-align: left;">Visited</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody style="font-family: Arial; font-size: 9pt;">
            <% for (let iCount = 0; iCount < mycountry.length; iCount++) { %>
                <tr>
                    <td><%= mycountry[iCount].country_name %></td>
                    <td><%= mycountry[iCount].popular_site %></td>
                    <td><%= mycountry[iCount].capital %></td>
                    <td><%= mycountry[iCount].population %></td>
                    <td><%= mycountry[iCount].visited %></td>
                    <td style="text-align: center;">
                        <form action="/editCountry/<%= mycountry[iCount].country_id %>" method="GET">
                            <button type="submit">Edit</button>
                        </form>
                    </td>
                    <td style="text-align: center;">
                        <form action="/deleteCountry/<%= mycountry[iCount].country_id %>"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this country?');">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                    <td style="text-align: center;">
                        <button type="button"
                            data-country="<%= mycountry[iCount].country_name %>"
                            onclick="showMap(this.dataset.country)">Map</button>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
    <br><br>
    <form action="/addCountry" method="GET">
        <button type="submit">Add Country</button>
    </form>
    <br><br>
    <h2 id="mapTitle"></h2>
    <iframe
        id="countryMap"
        title="Country map"
        width="600"
        height="400"
        style="display: none; max-width: 100%; border: 0;">
    </iframe>
    <script>
        function showMap(country) {
            document.getElementById("mapTitle").textContent = country;

            document.getElementById("countryMap").src =
                "https://maps.google.com/maps?q=" +
                encodeURIComponent(country) +
                "&output=embed";

            document.getElementById("countryMap").style.display = "block";
        }
    </script>
</body>
</html>